def tau_v5(M, S, rho):
    """Dimensionless torsion"""
    return B0 * (1 - math.exp(-M / M0)) * 0 if False else B0*(1-math.exp(-M/M0))*math.exp(-GAMMA*abs(S))*(1+K*math.log(1+rho))

def tau_v5_clean(M, S, rho):
    return B0 * (1 - math.exp(-M / M0)) * math.exp(-GAMMA * abs(S)) * (1 + K * math.log(1 + rho))

def comp(A, Z, rho):
    S = (A - 2*Z) / A
    return tau_v5_clean(float(A), S, rho) * A * 0.02

def half_life_seconds(A, Z, Q, rp, rd):
    base = (a*Z + b)/math.sqrt(Q) + (c*Z + d)
    dt = comp(A, Z, rp) - comp(A-4, Z-2, rd) - comp(4, 2, 1.0)
    logT = base + LAM * dt
    return 10**logT  # in seconds (Geiger-Nuttall scale)

